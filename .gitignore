# Android release signing — NEVER commit. Losing the keystore = can
# never update the Play listing. The canonical copy lives as the
# GitHub Actions secret + in the developer's password manager.
android/mood8-release.jks
android/*.jks
android/*.keystore
android/key.properties

# Handoff files for the Android release keystore. NEVER commit.
android/keystore_base64.txt
android/keystore_secrets.txt

# NOTE: android/app/google-services.json IS committed — it holds only
# public identifiers (project id, app id, project number), no secrets.
# Firebase's own docs recommend committing it so builds are
# reproducible without extra setup. If you fork Mood8 and want crash
# reports going to YOUR Firebase project, replace this file with your
# own before publishing under a different package name.
